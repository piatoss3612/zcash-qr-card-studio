{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zcash-support-cards",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": false },
}
